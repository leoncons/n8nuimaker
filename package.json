{
  "name": "n8nuimaker",
  "version": "1.0.0",
  "type": "module",
  "description": "n8n UI Maker Tool - Generate shareable frontend UIs for n8n workflows",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
