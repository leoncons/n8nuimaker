    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": ["n8n", "ui", "maker", "workflow", "automation"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7",
    "react-hook-form": "^7.49.2",
    "lucide-react": "^0.294.0",
    "clsx": "^2.0.0",
    "qrcode": "^1.5.3",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "jest": "^29.5.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
